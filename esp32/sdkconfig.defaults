# Wi-Fi credentials (override via menuconfig)
CONFIG_PROXY_WIFI_SSID="YourSSID"
CONFIG_PROXY_WIFI_PASSWORD="YourPassword"

# Flash size — XIAO ESP32-S3 has 8MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# lwIP — need enough sockets for RTP, RTCP, SSDP, HTTP client, HTTP server
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
# Larger TCP windows for smoother audio streaming
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11440
CONFIG_LWIP_TCP_WND_DEFAULT=11440
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y

# Task watchdog — increase timeout for long-running audio handler
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Partition table — custom layout with larger factory partition for firmware + embedded web UI
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
